# Copie este arquivo para .env.local (dev), .env.staging ou .env.production
# e preencha com as credenciais do projeto Supabase correspondente.
# NUNCA commite arquivos .env com valores reais — apenas este .example.

# Painel Supabase > Project Settings > API
VITE_SUPABASE_URL=https://<seu-projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key-publica>

# Chave pública VAPID, usada pelo frontend para se inscrever no Web Push.
# Gerar com: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=<vapid-public-key>

# --- Apenas em ambiente de servidor / Edge Functions (NUNCA no frontend) ---
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# VAPID_PRIVATE_KEY=<vapid-private-key>
# VAPID_SUBJECT=mailto:sindico@condominio.com
